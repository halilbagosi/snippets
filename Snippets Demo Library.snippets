  {
   "id": "12882FDF-D08E-4E77-BCF6-32F6BE24746F",
   "title": "Chunk List",
   "description": "Split any list into fixed-size pieces.",
   "language": "Python",
   "code": "from itertools import islice\n\ndef chunked(iterable, size):\n    \"\"\"Yield successive lists of `size` items.\"\"\"\n    it = iter(iterable)\n    while batch := list(islice(it, size)):\n        yield batch\n\nfor batch in chunked(range(10), 3):\n    print(batch)",
   "createdAt": "2026-10-11T01:00:00.000Z",
   "updatedAt": "2026-10-13T03:00:00.000Z",
