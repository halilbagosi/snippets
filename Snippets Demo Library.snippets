  {
   "id": "EE5915B3-7195-4B85-95D9-91D1F919FCB9",
   "title": "Fetch JSON",
   "description": "Typed fetch with a timeout.",
   "language": "JavaScript",
   "code": "export async function getJSON(url, { timeout = 8000 } = {}) {\n  const ctrl = new AbortController();\n  const id = setTimeout(() => ctrl.abort(), timeout);\n  try {\n    const res = await fetch(url, { signal: ctrl.signal });\n    if (!res.ok) throw new Error(`HTTP ${res.status}`);\n    return await res.json();\n  } finally {\n    clearTimeout(id);\n  }\n}",
   "createdAt": "2026-10-11T16:00:00.000Z",
   "updatedAt": "2026-10-13T18:00:00.000Z",
   "isFavorite": false,
   "copyCount": 17,
