  {
   "id": "435EACD0-45C5-47FB-A3AE-B2BDF15C22C9",
   "title": "Debounce",
   "description": "Delay a call until input settles.",
   "language": "TypeScript",
   "code": "export function debounce<T extends (...args: any[]) => void>(\n  fn: T,\n  wait = 250\n): (...args: Parameters<T>) => void {\n  let timer: ReturnType<typeof setTimeout> | undefined;\n  return (...args) => {\n    clearTimeout(timer);\n    timer = setTimeout(() => fn(...args), wait);\n  };\n}",
   "createdAt": "2026-10-12T04:00:00.000Z",
   "updatedAt": "2026-10-14T06:00:00.000Z",
   "isFavorite": true,
   "copyCount": 31,
