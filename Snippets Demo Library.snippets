  {
   "id": "84886051-D80F-405D-8E46-678027B20012",
   "title": "Clamp",
   "description": "Keep a value inside a range.",
   "language": "Swift",
   "code": "extension Comparable {\n    func clamped(to range: ClosedRange<Self>) -> Self {\n        min(max(self, range.lowerBound), range.upperBound)\n    }\n}\n\nlet opacity = 1.4.clamped(to: 0...1) // 1.0",
   "createdAt": "2026-10-11T06:00:00.000Z",
