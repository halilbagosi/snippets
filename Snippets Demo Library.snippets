  {
   "id": "4F58CE64-4DF3-4DB2-A03E-38BD823CC01A",
   "title": "Staggered Fade In",
   "description": "CSS keyframes with per-item delays.",
   "language": "CSS",
   "code": ".item {\n  opacity: 0;\n  transform: translateY(12px);\n  animation: rise 420ms cubic-bezier(.2,.8,.2,1) forwards;\n}\n.item:nth-child(n) { animation-delay: calc(var(--i) * 40ms); }\n\n@keyframes rise {\n  to { opacity: 1; transform: none; }\n}",
   "createdAt": "2026-10-11T19:00:00.000Z",
   "updatedAt": "2026-10-13T21:00:00.000Z",
