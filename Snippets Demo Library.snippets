  {
   "id": "A6AC2714-51A6-4271-9E97-BD7D6C2A9B78",
   "title": "Spring Counter",
   "description": "A React counter that springs on every tap.",
   "language": "React",
   "code": "export default function Counter() {\n  const [count, setCount] = React.useState(0);\n  return (\n    <div style={{display:\"grid\",placeItems:\"center\",height:\"100vh\"}}>\n      <button onClick={() => setCount(c => c + 1)}\n              style={{fontSize: 32, padding: \"20px 36px\", borderRadius: 20}}>\n        Count: {count}\n      </button>\n    </div>\n  );\n}",
   "createdAt": "2026-10-11T23:00:00.000Z",
