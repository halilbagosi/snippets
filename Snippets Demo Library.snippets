  {
   "id": "10D6E8A7-66FB-4FB5-9844-28843191ACC6",
   "title": "Liquid Rings",
   "description": "Concentric ripples with a soft chromatic edge.",
   "language": "Metal",
   "code": "fragment float4 rings(VertexOut in [[stage_in]],\n                      constant SnippetUniforms& u [[buffer(0)]]) {\n    float2 p = in.uv * 2.0 - 1.0;\n    p.x *= u.resolution.x / u.resolution.y;\n    float r = length(p);\n    float w = sin(r * 18.0 - u.time * 3.0);\n    float3 col = 0.5 + 0.5 * cos(u.time + r * 4.0 + float3(0, 2, 4));\n    col *= smoothstep(0.0, 0.9, w * 0.5 + 0.5);\n    return float4(col * (1.2 - r), 1.0);\n}",
   "createdAt": "2026-10-12T02:00:00.000Z",
   "updatedAt": "2026-10-14T04:00:00.000Z",
   "isFavorite": false,
   "copyCount": 6,
