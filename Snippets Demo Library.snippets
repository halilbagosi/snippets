  {
   "id": "06A9DB76-81EE-467B-BB7A-715BE9FD33BD",
   "title": "Aurora Plasma",
   "description": "Layered sine fields that drift like northern lights.",
   "language": "GLSL",
   "code": "// Aurora plasma \u2014 Shadertoy style\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    vec2 uv = fragCoord / iResolution.xy;\n    float t = iTime * 0.35;\n    float v = sin(uv.x * 6.0 + t) + sin(uv.y * 5.0 - t * 1.3);\n    v += sin((uv.x + uv.y) * 7.0 + t * 0.7);\n    v += sin(length(uv - 0.5) * 12.0 - t * 2.0);\n    vec3 a = vec3(0.10, 0.05, 0.45);\n    vec3 b = vec3(0.20, 0.85, 0.95);\n    vec3 c = vec3(0.85, 0.30, 0.95);\n    vec3 col = mix(a, b, 0.5 + 0.5 * sin(v));\n    col = mix(col, c, 0.5 + 0.5 * cos(v * 0.7 + t));\n    fragColor = vec4(col, 1.0);\n}",
   "createdAt": "2026-10-12T05:00:00.000Z",
   "updatedAt": "2026-10-14T07:00:00.000Z",
   "isFavorite": true,
   "copyCount": 14,
   "collectionIDs": [
    "1702B973-2F5A-440C-BCCA-26B43A5A25CB"
   ],
