  {
   "id": "07F39F32-605F-4D5E-A22B-2D6BD97737D9",
   "title": "Haptic Press Style",
   "description": "A SwiftUI button style with scale and haptics.",
   "language": "Swift",
   "code": "struct PressableStyle: ButtonStyle {\n    func makeBody(configuration: Configuration) -> some View {\n        configuration.label\n            .scaleEffect(configuration.isPressed ? 0.96 : 1)\n            .animation(.spring(response: 0.25, dampingFraction: 0.7),\n                       value: configuration.isPressed)\n            .sensoryFeedback(.impact, trigger: configuration.isPressed)\n    }\n}",
   "createdAt": "2026-10-12T01:00:00.000Z",
   "updatedAt": "2026-10-14T03:00:00.000Z",
   "isFavorite": false,
