  {
   "id": "CB4E2C7E-5F02-497E-8814-F5D8AF42BFA5",
   "title": "Glass Button",
   "description": "A frosted pill button with a moving sheen.",
   "language": "HTML",
   "code": "<button class=\"glass\">Get Started</button>\n<style>\n  body { display:grid; place-items:center; height:100vh; margin:0;\n         background: radial-gradient(circle at 30% 20%, #7c3aed, #1e1b4b 70%); }\n  .glass { font: 600 18px -apple-system; color:white; padding:16px 40px;\n           border-radius:999px; border:1px solid #ffffff55;\n           background:#ffffff22; backdrop-filter: blur(12px);\n           box-shadow: 0 10px 40px #0006; cursor:pointer; }\n  .glass:hover { background:#ffffff33; }\n</style>",
   "createdAt": "2026-10-12T06:00:00.000Z",
